{
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed",
  },
  "vim_mode": true,
  "icon_theme": "Catppuccin Latte",
  "theme": "Catppuccin Latte (Blur) [Heavy]",
  "base_keymap": "VSCode",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_weight": 400,
  "ui_font_size": 16,
  "multi_cursor_modifier": "alt",
  "cursor_shape": "bar",
  "cursor_blink": false,
  "outline_panel": {
    "dock": "right",
  },
  "indent_guides": {
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },
  "project_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "breadcrumbs": true,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
    "quick_actions": false,
  },
  "format_on_save": "on",
  "use_on_type_format": true,
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "lsp": {
    "tinymist": {
      "initialization_options": {
        "preview": {
          // background preview : http://127.0.0.1:23635
          "background": {
            "enabled": true,
          },
        },
      },
    },
  },
  "languages": {
    "Typst": {
      "soft_wrap": "none",
    },
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
  },
}
