theme = Catppuccin Latte
font-family = JetBrainsMono Nerd Font
term = xterm-256color
link-url = true
link-previews = true
cursor-click-to-move = true
mouse-hide-while-typing = true
unfocused-split-opacity = 0.3
font-size=18
font-thicken=true
font-thicken-strength=1
cursor-style=block
keybind = shift+enter=text:\n
